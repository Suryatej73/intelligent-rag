# Groq API Configuration (Required for LLM inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
LANGCHAIN_PROJECT=zyro-rag-challenge

# Submission Metadata
STREAMLIT_APP_URL=https://your-app-name.streamlit.app
LANGSMITH_TRACE_URL=https://smith.langchain.com/public/your-trace-id/r
